{
  "name": "humanoidonline-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert \"@zeromatch|@discovery\"",
    "e2e:zero": "playwright test --grep @zeromatch",
    "e2e:discovery": "playwright test --project=desktop-chromium --grep @discovery",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "perf:budget": "node scripts/perf-budget.mjs",
    "e2e:desktop": "playwright test --project=desktop-chromium --grep-invert \"@zeromatch|@discovery\"",
    "e2e:mobile": "playwright test --project=mobile-chromium --grep-invert \"@zeromatch|@discovery\""
  },
  "dependencies": {
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@netlify/edge-functions": "^4.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
