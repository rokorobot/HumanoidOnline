# WS8.7 — production environment TEMPLATE. Copy to `.env.production` ON THE VPS,
# fill in real values, then: chown root:root .env.production && chmod 600 it.
# NEVER commit the filled file. Every value below is explicit: there are no
# credential or hostname defaults to fall back on (WS8-L5).
#
# QUOTING. This one file is read by three parsers — `docker compose --env-file`,
# systemd's `EnvironmentFile=` (the backup timer) and `sh`'s `.` (the cron
# equivalent). All three treat an unquoted value as ending at whitespace or a
# trailing ` #`, so ANY VALUE CONTAINING SPACES MUST BE DOUBLE-QUOTED:
#
#   BACKUP_UPLOAD_COMMAND="rclone copy {path} remote:humanoidonline/backups"
#
# A single-token value (an image digest, a URL, a password with no spaces) needs
# no quotes. Note that compose expands `$VAR` inside DOUBLE quotes, so a value
# that must contain a literal `$` belongs in SINGLE quotes (or write `$$`).

# ---------------------------------------------------------------- release ----
# The exact commit the images were built from. Both images are tagged with it and
# compose refuses to start without it, so a deployment always names its release.
#
# `deploy/preflight.py` enforces this properly: it must be a FULL 40-character
# lower-case commit id, it must equal `git rev-parse HEAD` in the checkout being
# released, and the working tree must be clean (no staged changes, no modified
# tracked files, no non-ignored untracked files). A detached HEAD is fine — that
# is the normal way to deploy an exact commit. Otherwise the images would carry
# code the recorded commit does not describe, and the rollback unit would be a
# lie.  Get it with:  git rev-parse HEAD
RELEASE_SHA=

# Where the durable release manifests live: one JSON file per release recording
# the commit, the four base pins, both image TAGS and both exact image IDs.
# MUST be outside the repository and outside the Docker build context — a
# manifest swept into an image, or removed by checking out the very release you
# are trying to undo, is not a rollback record. Created 0700, files 0600.
# `deploy/rollback.sh <manifest>` consumes one; retain the previous release's.
RELEASE_DIR=/srv/humanoidonline/releases

# ---------------------------------------------------- production image pins ---
# All four MUST be pinned to an immutable DIGEST before deploying, and the values
# recorded in the R26 attestation. They ship BLANK on purpose: a mutable tag here
# would silently reintroduce "whatever that tag points at today" and break the
# reproducible-build promise. Nothing falls back, at three levels —
#   * the Dockerfiles declare PYTHON_IMAGE / NODE_IMAGE with NO default, so a
#     build without --build-arg stops;
#   * compose declares POSTGRES_IMAGE / CADDY_IMAGE as REQUIRED (`:?`), so
#     `docker compose up` refuses to start without them; and
#   * `deploy/preflight.py` — run FIRST by the supported path `deploy/release.sh`
#     — checks the FORM of all four and rejects a mutable tag (`postgres:16`)
#     before anything is pulled, built or started. Non-empty is not pinned.
#
# Accepted: <image>[:tag]@sha256:<64 lower-case hex>, or a bare sha256:<64 hex>.
# Rejected: python:3.12-slim, node:20-bookworm-slim, postgres:16, caddy:2.
#
# Digest form (examples only — resolve the real digests yourself, e.g.
# `docker buildx imagetools inspect python:3.12-slim-bookworm`):
#   PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<64-hex>
#   NODE_IMAGE=node:20-bookworm-slim@sha256:<64-hex>
#   POSTGRES_IMAGE=postgres:16@sha256:<64-hex>
#   CADDY_IMAGE=caddy:2@sha256:<64-hex>
#
# PYTHON_IMAGE / NODE_IMAGE are BUILD args (passed with --build-arg); the other
# two are runtime image references read by compose.
PYTHON_IMAGE=
NODE_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=

# ------------------------------------------------------------ environment ----
# Strict. Unset/empty would also resolve to production, but say it explicitly.
APP_ENV=production

# ---------------------------------------------------------------- database ---
POSTGRES_USER=humanoid
# generate: openssl rand -hex 32
# URI-SAFE ON PURPOSE. This password is embedded in DATABASE_URL below, and a
# generator like `openssl rand -base64 36` emits `+`, `/` and `=`, which change
# meaning inside a URL userinfo field and silently produce a wrong (or invalid)
# connection string. Hex avoids the problem entirely. If you use a different
# generator anyway, you MUST percent-encode the password before pasting it into
# DATABASE_URL (`:` -> %3A, `/` -> %2F, `@` -> %40, `+` -> %2B, `=` -> %3D, …).
POSTGRES_PASSWORD=
POSTGRES_DB=humanoidonline
# Must match the three values above. Host is the compose service name.
# Note: backups do NOT use this URL — pg_dump runs inside the db container and
# reads POSTGRES_USER / POSTGRES_DB from the container's own environment, so the
# password never appears in a process argument (deploy/backup.py).
DATABASE_URL=postgresql+psycopg://humanoid:<password>@db:5432/humanoidonline

# ------------------------------------------------------------------ ingress --
SITE_DOMAIN=humanoidonline.com
ACME_EMAIL=                   # Let's Encrypt contact address

# DEP P1 — the trusted ingress, as FastAPI sees it: EXACTLY Caddy's address on
# the ho_prod network (docker-compose.prod.yml assigns it statically). Not the
# VPS public IP, not a broad CIDR. If the subnet changes, change this too.
TRUSTED_PROXY_IPS=172.30.0.2/32

# Strict same-origin: no CORS middleware is installed when this is empty (R4).
CORS_ALLOWED_ORIGINS=
# Defence in depth — Caddy is the deployment-level HSTS authority.
ENABLE_HSTS=true

# ------------------------------------------------------------------- web ------
# WS8-L5: REQUIRED in production. The web tier throws rather than falling back to
# http://localhost:8000. Internal service address, never the public domain.
API_BASE_URL=http://api:8000
# Canonical origin for JSON-LD / sitemap / robots / llms (WS8.2 / R8). Also
# required as a BUILD arg for the web image.
NEXT_PUBLIC_SITE_URL=https://humanoidonline.com

# ----------------------------------------------------------------- admin ------
# The admin surface is mounted on the single API instance; its BOUNDARY is the
# loopback-only Caddy listener (DEP P4). Application authentication below is
# mandatory in addition to that boundary — neither replaces the other.
# Leaving any of these blank fails closed: the admin is not mounted at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=               # generate: openssl rand -base64 36
ADMIN_SESSION_SECRET=         # generate: openssl rand -hex 32

# ---------------------------------------------------------------- backups -----
# PRIMARY recovery path (deploy/backup.py, run by the systemd timer documented in
# that file's header). It runs `pg_dump` INSIDE the db container over
# `docker compose exec -T`, because Postgres publishes no host port — nothing
# here opens the database up, and no credential is passed as an argument.
#
# MANDATORY in staging/production, at TWO points: `deploy/release.sh` refuses to
# build or start when this is empty or when its executable cannot be found
# (checked, never executed — a preflight must not write to a remote
# destination), and the script itself REFUSES to run without it. A dump kept on
# the same disk as the database is not a backup, and the first incident should
# not be when anyone finds that out. It is provider-neutral — any command works
# (rclone, rsync/ssh, aws s3, restic, b2). `{path}` is replaced with the artifact
# path; if you omit the placeholder the path is appended. QUOTE IT — it contains
# spaces:
#   BACKUP_UPLOAD_COMMAND="rclone copy {path} remote:humanoidonline/backups"
BACKUP_UPLOAD_COMMAND=

# Host directory for artifacts. Created 0700; each dump is written 0600, and the
# systemd unit sets UMask=0077.
BACKUP_DIR=/srv/humanoidonline/backups
# Local artifacts older than this are deleted — only this script's own
# timestamped files, and only AFTER a successful off-box upload. 0 disables.
BACKUP_RETENTION_DAYS=14

# How the backup reaches the running stack. Defaults match a deployment rooted at
# /srv/humanoidonline; set them explicitly if yours differs. BACKUP_COMPOSE_*
# names are deliberately NOT the compose-native COMPOSE_FILE / COMPOSE_PROJECT_NAME,
# which would change the behaviour of every other compose command run with this
# file loaded.
BACKUP_COMPOSE_FILE=/srv/humanoidonline/docker-compose.prod.yml
BACKUP_COMPOSE_ENV_FILE=/srv/humanoidonline/.env.production
# Must match `name:` in docker-compose.prod.yml.
BACKUP_COMPOSE_PROJECT=humanoidonline
BACKUP_DB_SERVICE=db
