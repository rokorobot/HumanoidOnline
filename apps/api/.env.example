# Copy to apps/api/.env for local overrides (gitignored). The default in
# app/config.py already matches docker-compose.yml, so this is only needed to
# point the API at a different database.
DATABASE_URL=postgresql+psycopg://humanoid:humanoid@localhost:5432/humanoidonline

# ---------------------------------------------------------------- WS8.1 -----
# Security boundaries (docs/12 WS8 contract, gates R1/R3/R4 + DEP P1-P5).

# R1 - internal admin at /admin. If ANY of these three is unset the admin is
# NOT mounted at all (fail closed). Set all three to use it locally.
# The production network boundary (admin on a separate protected host/listener,
# DEP P4) is realized in WS8.7 - these credentials are the application layer,
# not a substitute for it.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string; rotates every admin session when changed.
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------- AGENT-02 -----
# Evidence references (docs/20 7.1.1). DEDICATED key - never reuse
# ADMIN_SESSION_SECRET, the database password or any other secret here.
# Base64url of exactly 64 raw bytes (512-bit AES-SIV). Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(64)).decode().rstrip('='))"
# Unset (default) = agent evidence references fail closed. There is NO
# development default and no unsigned fallback: a shipped default key would be
# indistinguishable from no key, only harder to spot. Never commit a real key.
EVIDENCE_REF_KEY=
# Identifies the active key inside the opaque token so a rotation can be staged.
EVIDENCE_REF_KEY_ID=1
# Rotation window only: "<key_id>:<base64url>[,<key_id>:<base64url>]". References
# issued under a key that is neither active nor listed here simply do not
# resolve - never a distinguishable "expired key" answer.
EVIDENCE_REF_PREVIOUS_KEYS=

# DEP P1 - trusted ingress. Comma-separated IPs/CIDRs whose X-Forwarded-For may
# be believed. EMPTY (default) = no ingress trusted, all forwarding headers
# ignored, client address taken from the peer. Set this ONLY to the address(es)
# of your reverse proxy; a wrong value here is a rate-limit bypass.
# A non-empty but MALFORMED value fails to boot - it is never silently
# reinterpreted as "trust nobody", which would rate-limit every user behind the
# proxy as a single client.
TRUSTED_PROXY_IPS=

# R4 - cross-origin posture. EMPTY (default) = strict same-origin: no CORS
# middleware, no Access-Control-Allow-Origin ever emitted. Set to an explicit
# comma-separated origin allowlist to opt in ("*" is ignored by design).
CORS_ALLOWED_ORIGINS=
# Only enable behind TLS (terminates at the ingress, WS8.7).
ENABLE_HSTS=false

# R3 - endpoint-aware abuse controls. Two tiers per endpoint: a short burst
# window (rapid repeated submission) and a long sustained window (drip
# flooding). Defaults are in app/config.py; override per environment.
# There is no enable/disable switch: R3 abuse control is always on. Only the
# numbers below are environment-tunable.
# Limits key on client IP, which is SHARED behind office/campus/carrier NAT -
# sizing them too tightly refuses genuine buyers. Tune per environment.
# BUYER_REQUIREMENTS_BURST=20
# BUYER_REQUIREMENTS_BURST_WINDOW_S=60
# BUYER_REQUIREMENTS_SUSTAINED=120
# BUYER_REQUIREMENTS_SUSTAINED_WINDOW_S=3600
# COMMERCIAL_LEADS_BURST=10
# COMMERCIAL_LEADS_BURST_WINDOW_S=60
# COMMERCIAL_LEADS_SUSTAINED=60
# COMMERCIAL_LEADS_SUSTAINED_WINDOW_S=3600

# ---------------------------------------------------- lead notification -----
# Operational email to HumanoidOnline ops when POST /api/commercial-leads
# creates or extends a lead (app/services/lead_notifications.py). The database
# write is authoritative and already committed before this ever runs; this is
# a best-effort side channel, never a gate — a delivery failure never loses or
# rejects an already-valid lead.
#
# OFF by default. Only active when ALL FOUR of the values below are set; any
# missing/partial combination simply leaves the feature inert (never blocks
# the API from starting). This FastAPI backend deploys to Koyeb — these
# belong in the Koyeb service's production environment variables (Koyeb
# Console -> service -> Settings -> Environment variables), NEVER committed
# here or anywhere else in source control. Backend-only: do not add them to
# Netlify (the frontend) and never as NEXT_PUBLIC_* variables.
LEAD_NOTIFICATION_ENABLED=false
# Comma-separated recipient address(es).
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_FROM=
# Email provider API key. Never logged, never echoed in an error response.
EMAIL_API_KEY=
# Non-secret: the provider's HTTPS send endpoint. Defaults to Resend
# (https://resend.com/docs/api-reference/emails/send-email) - a plain POST +
# Bearer token, so no provider SDK is needed. Override only if migrating to a
# different provider.
# EMAIL_API_ENDPOINT=https://api.resend.com/emails
