# LOCAL DEVELOPMENT template. Copy to `.env` (gitignored). Never commit secrets.
# Production uses a different file with no defaults at all — see
# `.env.production.example` and docker-compose.prod.yml.
#
# The environment classifier is asymmetric and fails safe (WS8.2 / R7): APP_ENV
# unset or empty resolves to PRODUCTION (strict), an unrecognised value raises,
# and only `development` / `test` unlock convenience defaults. So a local
# checkout must say that it is local.
APP_ENV=development

# Postgres connection (matches docker-compose.yml). The "+psycopg" driver token
# is used by SQLAlchemy in apps/api; db/bootstrap.py tolerates and strips it.
DATABASE_URL=postgresql+psycopg://humanoid:humanoid@localhost:5432/humanoidonline

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL locally: with APP_ENV=development each has a safe
# development default. In staging/production they are REQUIRED and there is no
# fallback (WS8-L5) — that is the whole point of the environment contract.
# ---------------------------------------------------------------------------

# Web -> API origin. Development falls back to http://localhost:8000;
# staging/production must set it explicitly (apps/web/lib/server.ts).
# API_BASE_URL=http://localhost:8000

# Canonical origin for JSON-LD / sitemap.xml / robots.txt / llms.txt (R8).
# Development falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal admin (WS8.1 / R1). Absent credentials fail CLOSED: the admin surface
# is not mounted at all rather than mounted unprotected. Set all three to work on
# admin locally.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# DEP P1 — comma-separated IPs/CIDRs whose forwarding headers may be believed.
# EMPTY (the default) means NO ingress is trusted and every X-Forwarded-For is
# ignored, so a client cannot spoof its source address. In production this is
# exactly the reverse proxy's address (see .env.production.example).
# TRUSTED_PROXY_IPS=

# Explicit cross-origin posture (R4 / WS8-L9). EMPTY = strict same-origin: no
# CORS middleware is installed at all.
# CORS_ALLOWED_ORIGINS=

# TLS terminates at the ingress in production, so HSTS is opt-in and must never
# be advertised from a plain-HTTP local environment.
# ENABLE_HSTS=false
