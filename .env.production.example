# WS8.7 — production environment TEMPLATE. Copy to `.env.production` ON THE VPS,
# fill in real values, then: chown root:root .env.production && chmod 600 it.
# NEVER commit the filled file. Every value below is explicit: there are no
# credential or hostname defaults to fall back on (WS8-L5).

# ---------------------------------------------------------------- release ----
# The exact commit the images were built from. Both images are tagged with it and
# compose refuses to start without it, so a deployment always names its release.
RELEASE_SHA=

# Base images. Pin to an immutable DIGEST at deploy time and record the value in
# the R26 attestation, e.g. postgres:16@sha256:...
POSTGRES_IMAGE=postgres:16
CADDY_IMAGE=caddy:2

# ------------------------------------------------------------ environment ----
# Strict. Unset/empty would also resolve to production, but say it explicitly.
APP_ENV=production

# ---------------------------------------------------------------- database ---
POSTGRES_USER=humanoid
POSTGRES_PASSWORD=            # generate: openssl rand -base64 36
POSTGRES_DB=humanoidonline
# Must match the three values above. Host is the compose service name.
DATABASE_URL=postgresql+psycopg://humanoid:<password>@db:5432/humanoidonline

# ------------------------------------------------------------------ ingress --
SITE_DOMAIN=humanoidonline.com
ACME_EMAIL=                   # Let's Encrypt contact address

# DEP P1 — the trusted ingress, as FastAPI sees it: EXACTLY Caddy's address on
# the ho_prod network (docker-compose.prod.yml assigns it statically). Not the
# VPS public IP, not a broad CIDR. If the subnet changes, change this too.
TRUSTED_PROXY_IPS=172.30.0.2/32

# Strict same-origin: no CORS middleware is installed when this is empty (R4).
CORS_ALLOWED_ORIGINS=
# Defence in depth — Caddy is the deployment-level HSTS authority.
ENABLE_HSTS=true

# ------------------------------------------------------------------- web ------
# WS8-L5: REQUIRED in production. The web tier throws rather than falling back to
# http://localhost:8000. Internal service address, never the public domain.
API_BASE_URL=http://api:8000
# Canonical origin for JSON-LD / sitemap / robots / llms (WS8.2 / R8). Also
# required as a BUILD arg for the web image.
NEXT_PUBLIC_SITE_URL=https://humanoidonline.com

# ----------------------------------------------------------------- admin ------
# The admin surface is mounted on the single API instance; its BOUNDARY is the
# loopback-only Caddy listener (DEP P4). Application authentication below is
# mandatory in addition to that boundary — neither replaces the other.
# Leaving any of these blank fails closed: the admin is not mounted at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=               # generate: openssl rand -base64 36
ADMIN_SESSION_SECRET=         # generate: openssl rand -hex 32
