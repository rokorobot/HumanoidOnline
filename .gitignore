# --- Node / Next.js (apps/web, WS1+) ---
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Python / FastAPI (apps/api, WS1+) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Environment & secrets ---
.env
.env.*
# Templates carry NO values — only variable names and guidance — so they are
# committed. The filled files (.env, .env.production) never are.
!.env.example
!.env.production.example

# --- Database ---
*.dump
# Incomplete dumps (deploy/backup.py writes here before atomic promotion).
*.dump.part
pgdata/

