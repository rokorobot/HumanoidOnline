# Copy to apps/web/.env.local for local development (gitignored).

# Server-side base URL of the FastAPI backend. Server Components fetch the
# knowledge API through this. Never shipped to the client bundle.
API_BASE_URL=http://localhost:8000

# Kept for any client-side needs; falls back for API_BASE_URL if that is unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
